@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap');

:root { font-family: Inter, system-ui, sans-serif; color: #f8fafc; background: #0b0f19; font-synthesis: none; }
* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; background: #0b0f19; }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }

.app-shell { min-height: 100vh; display: flex; background: #0b0f19; }
.sidebar { width: 248px; flex: 0 0 248px; border-right: 1px solid #1f2937; padding: 28px 18px; display: flex; flex-direction: column; background: #0d121e; }
.brand { display: flex; align-items: center; gap: 12px; padding: 0 10px 34px; }
.brand-mark { width: 34px; height: 34px; display: grid; place-items: center; background: #00e5ff; color: #0b0f19; font-weight: 800; border-radius: 9px; }
.brand strong { display: block; font-size: 16px; letter-spacing: -.4px; }
.brand span { display: block; color: #697386; font: 9px 'JetBrains Mono', monospace; margin-top: 3px; }
nav { display: grid; gap: 8px; }
.nav-item { border: 0; background: transparent; color: #8792a4; padding: 13px 12px; border-radius: 8px; text-align: left; font-size: 13px; font-weight: 600; }
.nav-item span { display: inline-block; width: 22px; color: #647084; }
.nav-item:hover, .nav-item.active { color: #f8fafc; background: #151d2c; }
.nav-item.active span { color: #00e5ff; }
.sidebar-bottom { margin-top: auto; display: flex; gap: 10px; align-items: center; border-top: 1px solid #1f2937; padding: 20px 10px 4px; }
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 12px #34d399; }
.sidebar-bottom strong { display: block; font-size: 12px; color: #dbe5ef; }
.sidebar-bottom small { display: block; color: #697386; margin-top: 4px; font-size: 10px; }

.main-content { max-width: 1400px; width: 100%; margin: 0 auto; padding: 34px 46px 28px; }
.topbar { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 30px; }
.eyebrow { margin: 0 0 8px; color: #778397; font: 10px 'JetBrains Mono', monospace; letter-spacing: .13em; }
.eyebrow.cyan { color: #00e5ff; }
h1, h2, h3, p { margin-top: 0; }
h1 { margin-bottom: 0; font-size: 29px; letter-spacing: -.8px; }
h2 { font-size: 31px; line-height: 1.13; letter-spacing: -1px; margin-bottom: 15px; }
h3 { font-size: 18px; margin-bottom: 5px; letter-spacing: -.3px; }
.topbar-meta { display: flex; align-items: center; gap: 10px; color: #758095; font: 11px 'JetBrains Mono', monospace; }
.live-pill { border: 1px solid #255a4b; padding: 6px 9px; color: #59dca7; border-radius: 20px; display: flex; gap: 6px; align-items: center; }
.live-pill i { width: 6px; height: 6px; background: #34d399; border-radius: 50%; }
.notice { margin: -9px 0 18px; padding: 11px 14px; border: 1px solid #19495b; background: #102532; color: #9deaff; font-size: 12px; display: flex; justify-content: space-between; }
.notice button { background: transparent; border: 0; color: inherit; font-size: 18px; }

.hero-panel, .devops-intro { min-height: 224px; display: flex; justify-content: space-between; align-items: center; gap: 30px; padding: 36px 42px; border: 1px solid #1f2937; background: linear-gradient(115deg, #121a2a, #0f1724 65%, #121628); }
.hero-panel > div:first-child, .devops-intro > div:first-child { max-width: 720px; }
.hero-panel p:not(.eyebrow), .devops-intro p:not(.eyebrow) { color: #9aa6b8; line-height: 1.7; max-width: 670px; font-size: 15px; margin-bottom: 0; }
.hero-orbit { position: relative; width: 260px; height: 160px; flex: 0 0 260px; }
.orbit-line { position: absolute; inset: 13px 24px; border: 1px solid #274256; border-radius: 50%; transform: rotate(-18deg); }
.orbit-core { position: absolute; left: 91px; top: 46px; width: 76px; height: 76px; border: 1px solid #00e5ff; color: #00e5ff; display: grid; place-items: center; text-align: center; font-weight: 700; font-size: 15px; background: #0f1927; border-radius: 50%; box-shadow: 0 0 22px rgba(0,229,255,.14); }
.orbit-core small { color: #9d4edd; font: 8px 'JetBrains Mono', monospace; }
.orbit-node { position: absolute; color: #8491a6; font: 9px 'JetBrains Mono', monospace; }
.n1 { left: 0; top: 25px; } .n2 { right: 4px; top: 20px; } .n3 { left: 7px; bottom: 20px; } .n4 { right: 9px; bottom: 14px; }

.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 16px 0; }
.stat-card { border: 1px solid #1f2937; background: #101723; padding: 18px 20px; position: relative; }
.stat-card::before { content: ''; position: absolute; left: 0; top: 0; height: 2px; width: 42px; background: #6c7890; }
.stat-card.cyan::before { background: #00e5ff; } .stat-card.violet::before { background: #9d4edd; } .stat-card.red::before { background: #f87171; } .stat-card.blue::before { background: #5b8cff; }
.stat-card span, .stat-card small { display: block; color: #8691a3; font-size: 11px; }.stat-card strong { display: block; margin: 11px 0 8px; font-size: 28px; }.stat-card small { font: 9px 'JetBrains Mono', monospace; color: #556174; }

.dashboard-grid, .devops-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
.panel { border: 1px solid #1f2937; background: #101723; padding: 24px; min-width: 0; }
.panel-title { border-bottom: 1px solid #1f2937; padding-bottom: 17px; margin-bottom: 18px; }.panel-title .eyebrow { margin-bottom: 6px; }.panel-title h3 { margin: 0; }
.form-grid { display: grid; gap: 14px; }.form-grid label, label { display: grid; gap: 7px; color: #a7b2c2; font-size: 11px; font-weight: 600; }
input, textarea, select { width: 100%; border: 1px solid #2a3547; background: #0b111c; color: #e6edf7; border-radius: 6px; padding: 11px 12px; outline: none; font-size: 13px; }
textarea { min-height: 96px; resize: vertical; line-height: 1.55; } input:focus, textarea:focus, select:focus { border-color: #00a9bf; box-shadow: 0 0 0 2px rgba(0,229,255,.1); }
button.primary-button, button.violet-button, button.secondary-button { border-radius: 6px; padding: 11px 14px; font-size: 12px; font-weight: 700; border: 1px solid transparent; }
.primary-button { background: #00d4ee; color: #071016; }.primary-button:hover { background: #65ebfb; }.violet-button { background: #9d4edd; color: white; }.secondary-button { background: transparent; border-color: #2c3c53 !important; color: #b9c8dc; }.secondary-button:hover { border-color: #00e5ff !important; color: #00e5ff; }
button:disabled { opacity: .55; cursor: not-allowed; }.button-row { display: flex; gap: 10px; }.full { width: 100%; }
.pipeline { display: grid; gap: 9px; }.pipeline-step { display: flex; align-items: center; gap: 13px; padding: 13px; background: #121c2a; border: 1px solid #1f2937; }.pipeline-step.active { border-color: #285f70; background: #102632; }.pipeline-step > span { width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid #33445b; color: #00e5ff; font: 10px 'JetBrains Mono', monospace; }.pipeline-step strong, .pipeline-step small { display: block; }.pipeline-step strong { font-size: 12px; }.pipeline-step small { color: #758397; font-size: 10px; margin-top: 3px; }

.devops-intro { min-height: 180px; }.module-badges { display: flex; flex-wrap: wrap; width: 250px; gap: 8px; }.module-badges span { border: 1px solid #27364b; padding: 9px; color: #aebbd0; font: 10px 'JetBrains Mono', monospace; }
.log-editor { min-height: 150px; font-family: 'JetBrains Mono', monospace; font-size: 11px; margin-bottom: 13px; }.log-editor.compact { min-height: 110px; }
.analysis-card { margin-top: 16px; border-left: 2px solid #00e5ff; background: #0c1b26; padding: 14px; color: #aebccc; font-size: 12px; line-height: 1.55; }.analysis-card.violet { border-left-color: #9d4edd; background: #1b1227; }.analysis-heading { display: flex; justify-content: space-between; color: #00e5ff; font: 11px 'JetBrains Mono', monospace; margin-bottom: 9px; }.analysis-card.violet .analysis-heading { color: #d39aff; }.analysis-card p { margin: 7px 0; }.analysis-card strong { color: #f2f7fb; }.analysis-card ul { padding-left: 18px; margin-bottom: 0; }.analysis-card li { margin: 4px 0; }
.repo-result { margin-top: 16px; border-top: 1px solid #1f2937; padding-top: 15px; }.repo-result strong { font-size: 15px; color: #f8fafc; }.repo-result p { color: #8996aa; font-size: 12px; line-height: 1.5; }.repo-meta { display: flex; gap: 14px; color: #00e5ff; font: 10px 'JetBrains Mono', monospace; }

.requests-panel { margin-top: 16px; }.request-list { display: grid; gap: 10px; }.request-row { display: flex; justify-content: space-between; gap: 20px; border: 1px solid #1f2937; background: #0d141f; padding: 16px; }.request-title { display: flex; gap: 10px; align-items: center; }.request-title strong { font-size: 13px; }.request-row p { margin: 8px 0; color: #909db0; font-size: 12px; }.request-row small { color: #617086; font: 10px 'JetBrains Mono', monospace; }.priority, .status { border-radius: 20px; padding: 4px 8px; font: 9px 'JetBrains Mono', monospace; }.priority-critical { color: #fb7185; background: #351a29; }.priority-high { color: #fbbf24; background: #322917; }.priority-medium, .priority-low { color: #8aa3bf; background: #1b2736; }.status-pending { color: #fbbf24; background: #332b17; }.status-in-progress { color: #67e8f9; background: #102e38; }.status-completed { color: #6ee7b7; background: #102d25; }.request-actions { display: flex; align-items: center; gap: 10px; }.request-actions select { width: 130px; padding: 8px; font-size: 11px; }.empty-state { text-align: center; border: 1px dashed #2a3547; padding: 55px; color: #8b98aa; }.empty-state strong, .empty-state span { display: block; }.empty-state strong { color: #e7edf4; margin-bottom: 8px; }.empty-state span { font-size: 12px; }
footer { display: flex; justify-content: space-between; gap: 20px; padding-top: 26px; color: #536075; font: 9px 'JetBrains Mono', monospace; }

@media (max-width: 980px) { .sidebar { width: 205px; flex-basis: 205px; }.main-content { padding: 25px; }.hero-panel, .devops-intro { align-items: flex-start; flex-direction: column; }.hero-orbit { align-self: center; }.dashboard-grid, .devops-grid { grid-template-columns: 1fr; } }
@media (max-width: 680px) { .app-shell { display: block; }.sidebar { width: 100%; height: auto; padding: 15px; border-right: 0; border-bottom: 1px solid #1f2937; }.brand { padding-bottom: 15px; }.sidebar-bottom { display: none; }nav { display: flex; overflow-x: auto; }.nav-item { white-space: nowrap; }.main-content { padding: 20px 15px; }.stat-grid { grid-template-columns: 1fr 1fr; }.request-row { flex-direction: column; }.request-actions { justify-content: space-between; }footer { flex-direction: column; }.module-badges { width: auto; } }


/* NexusOps account screens */
.auth-shell{min-height:100vh;display:grid;place-items:center;padding:28px;box-sizing:border-box;background:radial-gradient(circle at 15% 15%,rgba(0,229,255,.10),transparent 35%),radial-gradient(circle at 85% 80%,rgba(124,92,255,.12),transparent 35%),#0b0f19;color:#eef3ff}
.auth-card{width:min(100%,460px);box-sizing:border-box;padding:34px;border:1px solid rgba(130,155,200,.22);border-radius:22px;background:rgba(17,24,39,.96);box-shadow:0 24px 80px rgba(0,0,0,.35)}
.auth-brand{margin-bottom:32px}.auth-card h1{margin:10px 0;font-size:30px;letter-spacing:-.04em}.auth-subtitle{color:#a8b3c9;line-height:1.6;margin-bottom:22px}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:5px;border-radius:12px;background:#0b1220;margin:20px 0}
.auth-tab{border:0;border-radius:9px;padding:11px;background:transparent;color:#a8b3c9;cursor:pointer}.auth-tab.selected{background:#1c2940;color:#fff}
.auth-form{gap:16px}.auth-form label{display:grid;gap:8px;color:#c8d3e7;font-size:13px}.auth-form input{width:100%;box-sizing:border-box;padding:12px 13px;border:1px solid #303d55;border-radius:10px;background:#0b1220;color:#fff;outline:none}.auth-form input:focus{border-color:#00e5ff}
.auth-message{margin:0;color:#ff9caa;font-size:13px}.auth-note{display:block;margin-top:20px;color:#8492ac;line-height:1.5}
.account-name{color:#d7e4fa;font-weight:600}.logout-button{border:1px solid #34425c;border-radius:8px;padding:7px 10px;background:#121b2c;color:#dce7f8;cursor:pointer}.logout-button:hover{border-color:#00e5ff}
@media(max-width:560px){.auth-card{padding:24px}.auth-card h1{font-size:25px}}


/* Profile and administrator management */
.muted-copy{color:#9aa9c2;line-height:1.6;margin:0 0 22px}
.account-panel,.admin-panel{max-width:1100px}
.profile-form{max-width:540px;gap:16px}
.profile-form label{display:grid;gap:8px;color:#c8d3e7;font-size:13px}
.profile-form input,.admin-table select{box-sizing:border-box;padding:11px 12px;border:1px solid #303d55;border-radius:9px;background:#0b1220;color:#eef3ff;min-width:0}
.profile-form input:focus,.admin-table select:focus{outline:none;border-color:#00e5ff}
.profile-form input[readonly]{opacity:.75;text-transform:capitalize}
.account-summary{display:flex;gap:12px;align-items:center;flex-wrap:wrap;border-top:1px solid #26334a;margin-top:26px;padding-top:20px;color:#91a0ba;font-size:13px}
.account-summary strong{color:#eaf2ff;margin-right:18px}
.role-chip{display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(0,229,255,.1);color:#5deaff!important;text-transform:capitalize}
.admin-table-wrap{width:100%;overflow-x:auto}
.admin-table{width:100%;border-collapse:collapse;text-align:left;min-width:640px}
.admin-table th,.admin-table td{padding:14px 12px;border-bottom:1px solid #26334a;color:#c8d3e7;font-size:13px}
.admin-table th{color:#8d9db8;text-transform:uppercase;font-size:11px;letter-spacing:.08em}
.admin-table td strong{display:block;color:#f1f5ff}
.admin-table td small{display:block;color:#7f8da7;margin-top:5px}
.admin-table select{min-width:100px;text-transform:capitalize}
